#!/usr/bin/env python3
import subprocess
import sys
import json
import shutil
import os
import stat
import re
def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    return p.stdout,p.stderr,p.returncode

def main():
    if len(sys.argv)<2:
        print("usage: omarchy-kvm-create <jsonParamsFile>", file=sys.stderr); sys.exit(2)
    params_file=sys.argv[1]
    import json as js
    try:
        with open(params_file) as f:
            p=js.load(f)
    except Exception as e:
        print(f"invalid json: {e}", file=sys.stderr); sys.exit(2)
    name=p.get("name","")
    mem=p.get("memoryMb",2048)
    vcpus=p.get("vcpus",2)
    disk=p.get("diskSizeGb",20)
    pool=p.get("poolName","default")
    osvar=p.get("osVariant","generic")
    iso=p.get("isoPath","")
    net=p.get("networkName","default")
    firmware=p.get("bootFirmware","bios")
    graphics=p.get("graphicsType","spice")
    if not name:
        print("name required", file=sys.stderr); sys.exit(2)
    if not shutil.which("virt-install"):
        print("virt-install not found — install virtinst", file=sys.stderr); sys.exit(3)
    args=["virt-install","--connect","qemu:///system","--name",name,"--memory",str(mem),"--vcpus",str(vcpus),"--disk",f"size={disk},format=qcow2,pool={pool}","--os-variant",osvar,"--network",f"network={net},model=virtio","--graphics",graphics,"--noautoconsole"]
    # ── ISO handling: copy to private libvirt-accessible location if needed, without widening original parents ──
    effectiveIso = iso
    iso_tmp_copy = None
    if iso:
        if not os.path.exists(iso):
            print(f"ISO not found: {iso}", file=sys.stderr); sys.exit(2)
        # Use O_NOFOLLOW to safely open and check the ISO without following symlinks
        try:
            # Check if ISO is already in a libvirt-accessible location (pool dir, /var/lib/libvirt, /var/tmp)
            iso_abs = os.path.abspath(iso)
            # Get pool path to check if ISO is already inside the target pool or a known libvirt path
            pool_path = None
            # Try to get pool path via virsh pool-dumpxml
            pool_out, _, pool_code = run(["virsh", "--connect", "qemu:///system", "pool-dumpxml", pool])
            if pool_code == 0:
                import re
                m = re.search(r"<path>(.*?)</path>", pool_out)
                if m:
                    pool_path = os.path.abspath(m.group(1).strip())
            # Check if ISO is already under pool_path or under /var/lib/libvirt (already accessible)
            # All checks use O_NOFOLLOW descriptor to avoid symlink races
            already_accessible = False
            if pool_path and iso_abs.startswith(pool_path + os.sep):
                # Verify the file is actually under pool_path via descriptor (no symlink escape)
                try:
                    fd = os.open(iso_abs, os.O_RDONLY | os.O_NOFOLLOW)
                    try:
                        st = os.fstat(fd)
                        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid():
                            already_accessible = True
                            print(f"ISO already in target pool path {pool_path}, using directly", flush=True)
                        else:
                            print(f"ISO in pool path but not regular file or not owned by user, will copy", flush=True)
                    finally:
                        os.close(fd)
                except OSError as e:
                    print(f"ISO in pool path but cannot open safely: {e}, will copy", flush=True)
            elif iso_abs.startswith("/var/lib/libvirt/"):
                try:
                    fd = os.open(iso_abs, os.O_RDONLY | os.O_NOFOLLOW)
                    try:
                        st = os.fstat(fd)
                        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid():
                            if (st.st_mode & 0o004) or (st.st_mode & 0o040):
                                already_accessible = True
                                print(f"ISO already libvirt-accessible at {iso_abs}, using directly", flush=True)
                            else:
                                print(f"ISO at {iso_abs} not world/group-readable, will copy to private location", flush=True)
                        else:
                            print(f"ISO is not a regular file or not owned by user, will copy", flush=True)
                    finally:
                        os.close(fd)
                except OSError as e:
                    print(f"Cannot open ISO with O_NOFOLLOW (may be symlink or not regular file): {e}, will copy", flush=True)
            elif iso_abs.startswith("/var/tmp/") or iso_abs.startswith("/tmp/"):
                # Do not trust /tmp blindly — verify via descriptor
                try:
                    fd = os.open(iso_abs, os.O_RDONLY | os.O_NOFOLLOW)
                    try:
                        st = os.fstat(fd)
                        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid():
                            already_accessible = True
                            print(f"ISO in tmp and verified as regular file owned by user, using directly: {iso_abs}", flush=True)
                        else:
                            print(f"ISO in tmp but not regular file or not owned by user, will copy", flush=True)
                    finally:
                        os.close(fd)
                except OSError as e:
                    print(f"ISO in tmp but cannot open safely: {e}, will copy", flush=True)

            if not already_accessible:
                # Copy to a private, libvirt-accessible location without widening original parents
                # Prefer the target pool's directory (which is already 755 and owned appropriately)
                # Fallback to /var/tmp (which is 1777 and libvirt can read)
                dest_dir = None
                if pool_path and os.path.isdir(pool_path):
                    # Check if pool dir is writable (user has write via libvirt group or owner)
                    # Try to use pool dir
                    try:
                        # Test write via creating a temp file with O_NOFOLLOW and 0600
                        test_path = os.path.join(pool_path, ".write_test_" + str(os.getpid()))
                        fd_test = os.open(test_path, os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
                        os.close(fd_test)
                        os.unlink(test_path)
                        dest_dir = pool_path
                        print(f"Pool dir {pool_path} is writable, will copy ISO there", flush=True)
                    except:
                        print(f"Pool dir {pool_path} not writable for copy, trying /var/tmp", flush=True)
                        dest_dir = "/var/tmp"
                else:
                    dest_dir = "/var/tmp"

                # Ensure dest_dir exists and is accessible
                if not os.path.isdir(dest_dir):
                    print(f"Warning: dest dir {dest_dir} not found, using /var/tmp", file=sys.stderr, flush=True)
                    dest_dir = "/var/tmp"

                basename = os.path.basename(iso_abs)
                # Use a unique name to avoid collisions
                import tempfile
                # Create a secure temp file in dest_dir with 0600, then copy via descriptor to avoid TOCTOU
                try:
                    # Open source with O_NOFOLLOW (no symlink follow)
                    src_fd = os.open(iso_abs, os.O_RDONLY | os.O_NOFOLLOW)
                    try:
                        st = os.fstat(src_fd)
                        if not stat.S_ISREG(st.st_mode):
                            print(f"Error: ISO is not a regular file: {iso_abs}", file=sys.stderr)
                            sys.exit(1)
                        if st.st_uid != os.getuid():
                            print(f"Warning: ISO at {iso_abs} not owned by current user (uid {st.st_uid} vs {os.getuid()}), copying anyway with explicit consent via pool selection", flush=True)
                        dest_path = os.path.join(dest_dir, basename)
                        if os.path.exists(dest_path):
                            base, ext = os.path.splitext(basename)
                            dest_path = os.path.join(dest_dir, f"{base}_{os.getpid()}{ext}")
                            print(f"Dest exists, using {dest_path}", flush=True)
                        dest_fd = os.open(dest_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                        try:
                            # Copy via raw descriptors (avoid fdopen double-close)
                            while True:
                                data = os.read(src_fd, 1024 * 1024)
                                if not data:
                                    break
                                os.write(dest_fd, data)
                            os.fsync(dest_fd)
                        finally:
                            os.close(dest_fd)
                    finally:
                        os.close(src_fd)
                    try:
                        os.chmod(dest_path, 0o640)
                        try:
                            import grp
                            gid = grp.getgrnam("libvirt").gr_gid
                            os.chown(dest_path, -1, gid)
                        except:
                            pass
                    except:
                        pass
                    effectiveIso = dest_path
                    iso_tmp_copy = dest_path
                    print(f"ISO copied securely to private location {dest_path} (0600->640, no parent widening)", flush=True)
                except OSError as e:
                    print(f"Error: Cannot open ISO with O_NOFOLLOW: {e}", file=sys.stderr)
                    sys.exit(1)
            else:
                # Already accessible, use original
                effectiveIso = iso_abs
        except Exception as e:
            print(f"Error: ISO handling failed securely: {e}", file=sys.stderr)
            print(f"Not using original path to avoid symlink race. Please ensure the ISO is a regular file owned by you.", file=sys.stderr)
            sys.exit(1)
        # At this point, effectiveIso is either the original (if already accessible) or the secure copy
        if 'effectiveIso' not in locals() or not effectiveIso:
            print(f"Error: Failed to determine effective ISO path", file=sys.stderr)
            sys.exit(1)
        args+=["--cdrom",effectiveIso]
    else:
        args+=["--import"]
    if firmware=="uefi":
        args+=["--boot","uefi"]
    # run
    proc=subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in proc.stdout:
        print(line, end='', flush=True)
    proc.wait()
    sys.exit(proc.returncode)

if __name__=="__main__":
    main()
