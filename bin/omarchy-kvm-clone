#!/usr/bin/env python3
import re, subprocess, sys, shutil
SAFE_RE = re.compile(r"^[a-zA-Z0-9._-]+$")
def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    return p.stdout,p.stderr,p.returncode
def main():
    if len(sys.argv)<3:
        print("usage: omarchy-kvm-clone <source> <newName>", file=sys.stderr); sys.exit(2)
    src=sys.argv[1]; dst=sys.argv[2]
    for n in (src,dst):
        if not SAFE_RE.match(n) or len(n)>100:
            print("invalid name", file=sys.stderr); sys.exit(2)
    if shutil.which("virt-clone"):
        cmd=["virt-clone","--connect","qemu:///system","--original",src,"--name",dst,"--auto-clone"]
        out,err,code=run(cmd)
        if code!=0:
            print((err or out).strip(), file=sys.stderr); sys.exit(code)
        print(out.strip())
    else:
        # fallback via virsh dumpxml + define
        out,err,code=run(["virsh","--connect","qemu:///system","dumpxml",src])
        if code!=0:
            print(err.strip(), file=sys.stderr); sys.exit(code)
        # naive replace name and uuid removal
        import re
        xml=re.sub(r"<name>.*?</name>", f"<name>{dst}</name>", out, count=1)
        xml=re.sub(r"<uuid>.*?</uuid>\n?", "", xml)
        xml=re.sub(r"<source file=.*?>", "", xml)  # let libvirt clone disks? fallback needs virt-clone, so error
        print("virt-clone not found — install virtinst", file=sys.stderr); sys.exit(3)

if __name__=="__main__":
    main()
