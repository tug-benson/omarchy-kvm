#!/usr/bin/env python3
import subprocess, sys, json, re
def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=8)
    return p.stdout,p.stderr,p.returncode
def main():
    vm=sys.argv[1] if len(sys.argv)>1 else ""
    if not vm:
        # host stats via virsh nodemem, nproc
        out,_,_=run(["virsh","--connect","qemu:///system","nodememstats"])
        print(out)
        return
    # domstats
    out,err,code=run(["virsh","--connect","qemu:///system","domstats",vm])
    if code==0:
        print(out)
        return
    # fallback dominfo + cpu stats
    out,_,_=run(["virsh","--connect","qemu:///system","dominfo",vm])
    print(out)

if __name__=="__main__":
    main()
