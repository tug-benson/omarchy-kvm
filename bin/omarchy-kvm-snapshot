#!/usr/bin/env python3
import re, subprocess, sys
SAFE_RE = re.compile(r"^[a-zA-Z0-9._-]+$")

def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    return p.stdout, p.stderr, p.returncode

def main():
    if len(sys.argv)<3:
        print("usage: omarchy-kvm-snapshot <create|list|revert|delete> <vm> [snapName]", file=sys.stderr); sys.exit(2)
    op=sys.argv[1]
    vm=sys.argv[2]
    if not SAFE_RE.match(vm) or len(vm)>100:
        print("invalid vm", file=sys.stderr); sys.exit(2)
    uri="qemu:///system"
    if op=="list":
        out,err,code=run(["virsh","--connect",uri,"snapshot-list",vm])
        if code!=0:
            print(err.strip(), file=sys.stderr); sys.exit(code)
        print(out)
    elif op=="create":
        if len(sys.argv)<4: print("snap name required", file=sys.stderr); sys.exit(2)
        snap=sys.argv[3]
        if not SAFE_RE.match(snap) or len(snap)>100:
            print("invalid snap", file=sys.stderr); sys.exit(2)
        desc = sys.argv[4] if len(sys.argv)>4 else ""
        cmd=["virsh","--connect",uri,"snapshot-create-as",vm,snap]
        if desc: cmd+=["--description",desc]
        out,err,code=run(cmd)
        if code!=0: print((err or out).strip(), file=sys.stderr); sys.exit(code)
        print(out.strip())
    elif op=="revert":
        if len(sys.argv)<4: print("snap name required", file=sys.stderr); sys.exit(2)
        snap=sys.argv[3]
        if not SAFE_RE.match(snap): print("invalid snap", file=sys.stderr); sys.exit(2)
        out,err,code=run(["virsh","--connect",uri,"snapshot-revert",vm,snap])
        if code!=0: print((err or out).strip(), file=sys.stderr); sys.exit(code)
        print(out.strip())
    elif op=="delete":
        if len(sys.argv)<4: print("snap name required", file=sys.stderr); sys.exit(2)
        snap=sys.argv[3]
        if not SAFE_RE.match(snap): print("invalid snap", file=sys.stderr); sys.exit(2)
        out,err,code=run(["virsh","--connect",uri,"snapshot-delete",vm,snap])
        if code!=0: print((err or out).strip(), file=sys.stderr); sys.exit(code)
        print(out.strip())
    else:
        print("unknown op", file=sys.stderr); sys.exit(2)

if __name__=="__main__":
    main()
