#!/usr/bin/env python3
import re, subprocess, sys
SAFE_RE = re.compile(r"^[a-zA-Z0-9._-]+$")
def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    return p.stdout,p.stderr,p.returncode
def main():
    if len(sys.argv)<2:
        print("usage: omarchy-kvm-undefine <vm> [--remove-storage]", file=sys.stderr); sys.exit(2)
    vm=sys.argv[1]
    remove = "--remove-storage" in sys.argv
    if not SAFE_RE.match(vm) or len(vm)>100:
        print("invalid vm", file=sys.stderr); sys.exit(2)
    uri="qemu:///system"
    # if running, destroy first
    out,_,_ = run(["virsh","--connect",uri,"dominfo",vm])
    if "running" in out.lower():
        run(["virsh","--connect",uri,"destroy",vm])
    # undefine with flags
    cmd=["virsh","--connect",uri,"undefine",vm,"--managed-save","--snapshots-metadata"]
    if remove:
        # also remove nvram if uefi: add --nvram
        cmd.append("--nvram")
    out,err,code=run(cmd)
    if code!=0:
        print((err or out).strip(), file=sys.stderr); sys.exit(code)
    # if removeStorage, delete the volume from its pool (handle both old and new pool paths)
    if remove and code==0:
        # Try to find and delete the volume via libvirt (works for any pool, including custom home paths)
        # First, try to get the volume name from the dumpxml before undefine (we have it from earlier dumpxml if we saved, but we already undefined)
        # So we try to find volumes in all pools that match the VM name
        import os, glob
        # Try all pools
        pools_out, _, _ = run(["virsh","--connect",uri,"pool-list","--name"])
        pools = [p.strip() for p in pools_out.splitlines() if p.strip()]
        for pool in pools:
            vol_list, _, _ = run(["virsh","--connect",uri,"vol-list","--pool",pool])
            for line in vol_list.splitlines():
                if vm in line:
                    parts=line.split()
                    if parts:
                        vol_name=parts[0]
                        print(f"Deleting volume {vol_name} from pool {pool}...", flush=True)
                        out_vol, err_vol, code_vol = run(["virsh","--connect",uri,"vol-delete","--pool",pool,vol_name])
                        if code_vol==0:
                            print(f"Volume {vol_name} deleted from {pool}", flush=True)
                        else:
                            print(f"vol-delete failed for {vol_name} in {pool}: {err_vol.strip()}", file=sys.stderr)
                            # Fallback: try to remove file directly if we can find its path
                            # Get vol path via vol-dumpxml
                            vol_xml, _, _ = run(["virsh","--connect",uri,"vol-dumpxml","--pool",pool,vol_name])
                            m=re.search(r"<path>(.*?)</path>", vol_xml)
                            if m:
                                fpath=m.group(1).strip()
                                if os.path.exists(fpath):
                                    try:
                                        os.remove(fpath)
                                        print(f"Removed file {fpath} directly", flush=True)
                                    except Exception as e:
                                        print(f"Failed to remove {fpath}: {e}", file=sys.stderr)
        # Also try direct file removal for common locations (fallback for old pools)
        for path in glob.glob(f"/var/lib/libvirt/images/{vm}*") + glob.glob(f"/home/*/Documents/vms/{vm}*") + glob.glob(f"/home/*/VMs/{vm}*"):
            if os.path.exists(path):
                try:
                    # Try vol-delete first if pool is known, otherwise just rm
                    print(f"Removing file {path}...", flush=True)
                    os.remove(path)
                    print(f"Removed {path}", flush=True)
                except Exception as e:
                    print(f"Failed to remove {path}: {e}", file=sys.stderr)
    print(out.strip() or "undefined")

if __name__=="__main__":
    main()
