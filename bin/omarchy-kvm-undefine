#!/usr/bin/env python3
import re, subprocess, sys
SAFE_RE = re.compile(r"^[a-zA-Z0-9._-]+$")
def run(cmd):
    p=subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    return p.stdout,p.stderr,p.returncode
def main():
    if len(sys.argv)<2:
        print("usage: omarchy-kvm-undefine <vm> [--remove-storage]", file=sys.stderr); sys.exit(2)
    vm=sys.argv[1]
    remove = "--remove-storage" in sys.argv
    if not SAFE_RE.match(vm) or len(vm)>100:
        print("invalid vm", file=sys.stderr); sys.exit(2)
    uri="qemu:///system"
    # if running, destroy first
    out,_,_ = run(["virsh","--connect",uri,"dominfo",vm])
    if "running" in out.lower():
        run(["virsh","--connect",uri,"destroy",vm])
    # undefine with flags
    cmd=["virsh","--connect",uri,"undefine",vm,"--managed-save","--snapshots-metadata"]
    if remove:
        # also remove nvram if uefi: add --nvram
        cmd.append("--nvram")
    out,err,code=run(cmd)
    if code!=0:
        print((err or out).strip(), file=sys.stderr); sys.exit(code)
    # if removeStorage, parse dumpxml for disks and delete vols
    if remove and code==0:
        xml_out,_,xml_code=run(["virsh","--connect",uri,"dumpxml",vm])
        # But domain already undefined, so dumpxml fails — try before? We already handled. For now, list vols from default pool that match vm name
        # Simpler: delete via virsh vol-delete --pool default <vm>.qcow2 if exists
        # Attempt to find disk files via previous xml if we saved? Fallback: try to delete qcow2 in /var/lib/libvirt/images
        import os, glob
        for path in glob.glob(f"/var/lib/libvirt/images/{vm}*"):
            try:
                # try virStorageVolDelete via virsh vol-delete
                vol_name=os.path.basename(path)
                run(["virsh","--connect",uri,"vol-delete","--pool","default",vol_name])
                # fallback rm
                if os.path.exists(path):
                    os.remove(path)
            except: pass
        # also try pool vol-list
        vol_list,_ ,_ = run(["virsh","--connect",uri,"vol-list","--pool","default"])
        for line in vol_list.splitlines():
            if vm in line:
                parts=line.split()
                if parts:
                    run(["virsh","--connect",uri,"vol-delete","--pool","default",parts[0]])
    print(out.strip() or "undefined")

if __name__=="__main__":
    main()
