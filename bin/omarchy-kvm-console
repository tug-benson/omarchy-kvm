#!/usr/bin/env python3
import re, subprocess, sys, shutil, os

SAFE_RE = re.compile(r"^[a-zA-Z0-9._-]+$")

def main():
    if len(sys.argv)<2:
        print("usage: omarchy-kvm-console <vm>", file=sys.stderr); sys.exit(2)
    vm=sys.argv[1]
    if not SAFE_RE.match(vm) or len(vm)>100:
        print("invalid vm", file=sys.stderr); sys.exit(2)
    uri="qemu:///system"
    # prefer virt-viewer, fallback to remote-viewer, then virt-manager
    if shutil.which("virt-viewer"):
        cmd=["virt-viewer","--connect",uri,"--wait",vm]
    elif shutil.which("remote-viewer"):
        cmd=["remote-viewer",f"spice://localhost:5900"]  # generic fallback, but use virt-viewer path
        # actually remote-viewer can take same args as virt-viewer for libvirt
        cmd=["remote-viewer","--connect",uri,vm]
    elif shutil.which("virt-manager"):
        cmd=["virt-manager","--show-domain-console",vm]
    else:
        print("no virt-viewer/remote-viewer/virt-manager found", file=sys.stderr); sys.exit(3)
    # detach
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print("launched " + " ".join(cmd))

if __name__=="__main__":
    main()
